{
  "kind": "collectionType",
  "collectionName": "blogs",
  "info": {
    "singularName": "blog",
    "pluralName": "blogs",
    "displayName": "Blog"
  },
  "options": {
    "draftAndPublish": true
  },
  "pluginOptions": {},
  "attributes": {
    "title": {
      "type": "string"
    },
    "publishingDate": {
      "type": "date"
    },
    "imgae": {
      "type": "media",
      "multiple": false,
      "allowedTypes": [
        "images",
        "files",
        "videos",
        "audios"
      ]
    },
    "readTime": {
      "type": "string"
    },
    "authorName": {
      "type": "string"
    },
    "authorImage": {
      "type": "media",
      "multiple": false,
      "allowedTypes": [
        "images",
        "files",
        "videos",
        "audios"
      ]
    },
    "authorEmail": {
      "type": "email"
    },
    "description": {
      "type": "customField",
      "customField": "plugin::ckeditor5.CKEditor",
      "options": {
        "preset": "defaultMarkdown"
      }
    },
    "slug": {
      "type": "uid",
      "targetField": "title"
    },
    "facebookLink": {
      "type": "string"
    },
    "twitterLink": {
      "type": "string"
    },
    "pinterestLink": {
      "type": "string"
    },
    "linkedinLink": {
      "type": "string"
    }
  }
}
